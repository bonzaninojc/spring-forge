{
  "$schema": "./forge-schema.json",
  "project": {
    "basePackage": "com.myapp",
    "name": "MyEcommerceApp",
    "database": "postgres",
    "generateMigrations": true,
    "generateMappers": true,
    "generateFrontend": true,
    "generateRabbitMQ": true,
    "generateOpenApi": true,
    "generateSpringEvents": true,
    "generateScheduled": true,
    "generateTests": true,
    "generateCache": true,
    "templates": {
      "enabled": false,
      "templateDir": ".spring-forge/templates",
      "suffix": ".tpl",
      "overwrite": true,
      "visualTemplates": [
        {
          "name": "README por entidade",
          "scope": "entity",
          "enabled": true,
          "path": "docs/entities/{{entityKebab}}.md",
          "content": "# {{EntityName}}\n\nEndpoint: `/api/v1/{{entityPluralKebab}}`\n"
        }
      ]
    },
    "frontend": {
      "enabled": true,
      "framework": "react",
      "ui": "mui",
      "state": "redux-toolkit",
      "forms": "react-hook-form",
      "validation": "zod",
      "apiClient": true,
      "authPages": true,
      "protectedRoutes": true,
      "appShell": true,
      "filterPanel": true,
      "tableSorting": true,
      "confirmDialogs": true,
      "notifications": true,
      "darkMode": true
    },
    "pom": {
      "autoUpdate": true,
      "createBackup": true,
      "addComments": true,
      "managePlugins": true
    }
  },
  "entities": [
    {
      "name": "Category",
      "tableName": "categories",
      "auditable": true,
      "softDelete": false,
      "apiPath": "/api/v1/categories",
      "openApiTags": [
        "Categories"
      ],
      "cache": {
        "enabled": true,
        "ttlSeconds": 900,
        "maxSize": 200,
        "provider": "redis"
      },
      "exportImport": {
        "enabled": true,
        "formats": [
          "csv"
        ],
        "exportFields": [
          "name",
          "description",
          "active"
        ]
      },
      "fields": [
        {
          "name": "name",
          "type": "String",
          "required": true,
          "unique": true,
          "maxLength": 100
        },
        {
          "name": "description",
          "type": "String",
          "required": false,
          "maxLength": 500
        },
        {
          "name": "active",
          "type": "Boolean",
          "required": false,
          "defaultValue": "true"
        }
      ],
      "filters": [
        {
          "name": "name",
          "type": "String",
          "label": "Nome",
          "operator": "STARTS_WITH"
        },
        {
          "name": "active",
          "type": "Boolean",
          "label": "Ativo",
          "operator": "EQUALS"
        }
      ],
      "relations": [],
      "actions": []
    },
    {
      "name": "Product",
      "tableName": "products",
      "auditable": true,
      "softDelete": true,
      "apiPath": "/api/v1/products",
      "openApiTags": [
        "Products",
        "Inventory"
      ],
      "cache": {
        "enabled": true,
        "ttlSeconds": 600,
        "maxSize": 1000,
        "provider": "redis"
      },
      "exportImport": {
        "enabled": true,
        "formats": [
          "csv",
          "excel"
        ],
        "exportFields": [
          "name",
          "sku",
          "price",
          "stock",
          "status"
        ],
        "importFields": [
          "name",
          "sku",
          "price",
          "stock",
          "status"
        ]
      },
      "fields": [
        {
          "name": "name",
          "type": "String",
          "required": true,
          "maxLength": 200,
          "minLength": 3
        },
        {
          "name": "description",
          "type": "String",
          "required": false,
          "maxLength": 2000
        },
        {
          "name": "price",
          "type": "BigDecimal",
          "required": true,
          "validations": [
            "@jakarta.validation.constraints.DecimalMin(value = \"0.01\")"
          ]
        },
        {
          "name": "stock",
          "type": "Integer",
          "required": true,
          "validations": [
            "@jakarta.validation.constraints.Min(0)"
          ]
        },
        {
          "name": "sku",
          "type": "String",
          "required": true,
          "unique": true,
          "maxLength": 50
        },
        {
          "name": "status",
          "type": "Enum",
          "enumValues": [
            "ACTIVE",
            "INACTIVE",
            "OUT_OF_STOCK"
          ],
          "required": true
        }
      ],
      "filters": [
        {
          "name": "name",
          "type": "String",
          "label": "Nome do produto",
          "operator": "CONTAINS"
        },
        {
          "name": "sku",
          "type": "String",
          "label": "SKU",
          "operator": "STARTS_WITH"
        },
        {
          "name": "status",
          "type": "Enum",
          "enumValues": [
            "ACTIVE",
            "INACTIVE",
            "OUT_OF_STOCK"
          ],
          "label": "Status",
          "operator": "EQUALS"
        },
        {
          "name": "priceMin",
          "type": "BigDecimal",
          "label": "Preço mínimo",
          "operator": "GREATER_THAN_OR_EQUAL",
          "targetField": "price"
        },
        {
          "name": "priceMax",
          "type": "BigDecimal",
          "label": "Preço máximo",
          "operator": "LESS_THAN_OR_EQUAL",
          "targetField": "price"
        },
        {
          "name": "stockMin",
          "type": "Integer",
          "label": "Estoque mínimo",
          "operator": "GREATER_THAN_OR_EQUAL",
          "targetField": "stock"
        }
      ],
      "relations": [
        {
          "type": "ManyToOne",
          "targetEntity": "Category",
          "fieldName": "category",
          "fetch": "LAZY",
          "cascade": "MERGE,PERSIST"
        }
      ],
      "queues": [
        {
          "name": "product.stock.updated",
          "exchange": "products",
          "routingKey": "product.stock.updated",
          "durable": true,
          "direction": "PUBLISH"
        }
      ],
      "actions": [
        {
          "name": "activate",
          "description": "Ativa um produto inativo. Valida estoque mínimo antes de ativar.",
          "httpMethod": "POST",
          "apiPath": "/{id}/activate",
          "requiresId": true,
          "openApiResponses": [
            {
              "code": 422,
              "description": "Estoque abaixo do mínimo exigido"
            }
          ],
          "event": {
            "name": "ProductActivatedEvent",
            "generateListener": true,
            "async": true,
            "description": "Publicado quando um produto é ativado com sucesso"
          },
          "request": [
            {
              "name": "reason",
              "type": "String",
              "required": true,
              "maxLength": 255
            },
            {
              "name": "minimumStock",
              "type": "Integer",
              "required": false
            }
          ],
          "response": [
            {
              "name": "activated",
              "type": "Boolean"
            },
            {
              "name": "message",
              "type": "String"
            },
            {
              "name": "newStatus",
              "type": "String"
            }
          ]
        },
        {
          "name": "adjustStock",
          "description": "Ajusta estoque (positivo=entrada, negativo=saída). Publica evento na fila RabbitMQ.",
          "httpMethod": "PATCH",
          "apiPath": "/{id}/stock",
          "requiresId": true,
          "queues": [
            {
              "name": "product.stock.adjusted",
              "exchange": "products",
              "routingKey": "product.stock.adjusted",
              "durable": true,
              "direction": "BOTH",
              "deadLetterExchange": "products.dlx",
              "retryTtlMs": 60000
            }
          ],
          "request": [
            {
              "name": "quantity",
              "type": "Integer",
              "required": true
            },
            {
              "name": "reason",
              "type": "String",
              "required": true,
              "maxLength": 255
            },
            {
              "name": "operator",
              "type": "String",
              "required": false
            }
          ],
          "response": [
            {
              "name": "previousStock",
              "type": "Integer"
            },
            {
              "name": "currentStock",
              "type": "Integer"
            },
            {
              "name": "adjustedAt",
              "type": "LocalDateTime"
            }
          ]
        },
        {
          "name": "syncInventory",
          "description": "Sincroniza estoque com sistema externo. Executado automaticamente toda noite às 3h.",
          "scheduled": true,
          "scheduledCron": "0 0 3 * * *",
          "requiresId": false,
          "request": [],
          "response": [
            {
              "name": "synced",
              "type": "Integer"
            },
            {
              "name": "failed",
              "type": "Integer"
            },
            {
              "name": "syncedAt",
              "type": "LocalDateTime"
            }
          ]
        }
      ],
      "crud": {
        "pagination": true,
        "defaultPageSize": 20,
        "maxPageSize": 100,
        "defaultSort": "name",
        "defaultDirection": "ASC",
        "sortable": [
          "id",
          "name",
          "sku",
          "price",
          "stock",
          "status",
          "category.name"
        ],
        "filterable": [
          {
            "name": "categoryName",
            "type": "String",
            "label": "Categoria",
            "operator": "CONTAINS",
            "targetField": "category.name"
          }
        ],
        "bulkOperations": true
      }
    },
    {
      "name": "Order",
      "tableName": "orders",
      "auditable": true,
      "softDelete": false,
      "apiPath": "/api/v1/orders",
      "openApiTags": [
        "Orders"
      ],
      "cache": {
        "enabled": false
      },
      "exportImport": {
        "enabled": true,
        "formats": [
          "csv",
          "excel"
        ],
        "exportFields": [
          "customerName",
          "customerEmail",
          "total",
          "status"
        ]
      },
      "fields": [
        {
          "name": "customerName",
          "type": "String",
          "required": true,
          "maxLength": 200
        },
        {
          "name": "customerEmail",
          "type": "String",
          "required": true,
          "maxLength": 200,
          "validations": [
            "@jakarta.validation.constraints.Email"
          ]
        },
        {
          "name": "total",
          "type": "BigDecimal",
          "required": true,
          "inRequest": false
        },
        {
          "name": "status",
          "type": "Enum",
          "enumValues": [
            "PENDING",
            "CONFIRMED",
            "SHIPPED",
            "DELIVERED",
            "CANCELLED"
          ],
          "required": true
        },
        {
          "name": "notes",
          "type": "String",
          "required": false,
          "maxLength": 1000
        }
      ],
      "filters": [
        {
          "name": "customerName",
          "type": "String",
          "label": "Cliente",
          "operator": "CONTAINS"
        },
        {
          "name": "customerEmail",
          "type": "String",
          "label": "Email",
          "operator": "STARTS_WITH"
        },
        {
          "name": "status",
          "type": "Enum",
          "enumValues": [
            "PENDING",
            "CONFIRMED",
            "SHIPPED",
            "DELIVERED",
            "CANCELLED"
          ],
          "label": "Status"
        },
        {
          "name": "totalMin",
          "type": "BigDecimal",
          "label": "Total mínimo",
          "operator": "GREATER_THAN_OR_EQUAL",
          "targetField": "total"
        },
        {
          "name": "totalMax",
          "type": "BigDecimal",
          "label": "Total máximo",
          "operator": "LESS_THAN_OR_EQUAL",
          "targetField": "total"
        },
        {
          "name": "hasNotes",
          "type": "String",
          "label": "Tem observações",
          "operator": "IS_NOT_NULL",
          "targetField": "notes"
        }
      ],
      "relations": [],
      "queues": [
        {
          "name": "order.notifications",
          "exchange": "orders",
          "routingKey": "order.status",
          "durable": true,
          "direction": "CONSUME"
        }
      ],
      "actions": [
        {
          "name": "confirm",
          "description": "Confirma pedido pendente e inicia processamento.",
          "httpMethod": "POST",
          "apiPath": "/{id}/confirm",
          "requiresId": true,
          "event": {
            "name": "OrderConfirmedEvent",
            "generateListener": true,
            "async": false,
            "description": "Publicado quando um pedido é confirmado"
          },
          "queues": [
            {
              "name": "order.confirmed",
              "exchange": "orders",
              "routingKey": "order.confirmed",
              "durable": true,
              "direction": "PUBLISH"
            }
          ],
          "request": [],
          "response": [
            {
              "name": "confirmed",
              "type": "Boolean"
            },
            {
              "name": "confirmedAt",
              "type": "LocalDateTime"
            },
            {
              "name": "message",
              "type": "String"
            }
          ]
        },
        {
          "name": "cancel",
          "description": "Cancela pedido e estorna estoque dos itens.",
          "httpMethod": "POST",
          "apiPath": "/{id}/cancel",
          "requiresId": true,
          "openApiResponses": [
            {
              "code": 422,
              "description": "Pedido já foi entregue e não pode ser cancelado"
            }
          ],
          "request": [
            {
              "name": "reason",
              "type": "String",
              "required": true,
              "maxLength": 500
            },
            {
              "name": "notifyCustomer",
              "type": "Boolean",
              "required": false
            }
          ],
          "response": [
            {
              "name": "cancelled",
              "type": "Boolean"
            },
            {
              "name": "cancelledAt",
              "type": "LocalDateTime"
            }
          ]
        },
        {
          "name": "processExpiredOrders",
          "description": "Cancela automaticamente pedidos pendentes há mais de 24h.",
          "scheduled": true,
          "scheduledCron": "0 0 1 * * *",
          "requiresId": false,
          "request": [],
          "response": [
            {
              "name": "processed",
              "type": "Integer"
            },
            {
              "name": "ranAt",
              "type": "LocalDateTime"
            }
          ]
        }
      ]
    },
    {
      "name": "Session",
      "tableName": "sessions",
      "apiPath": "/api/v1/sessions",
      "auditable": true,
      "fields": [
        {
          "name": "token",
          "type": "String",
          "required": true,
          "unique": true,
          "maxLength": 180,
          "label": "Token",
          "inResponse": false
        },
        {
          "name": "ipAddress",
          "type": "String",
          "maxLength": 80,
          "label": "IP",
          "filterable": true
        },
        {
          "name": "userAgent",
          "type": "String",
          "maxLength": 500,
          "label": "User Agent"
        },
        {
          "name": "expiresAt",
          "type": "LocalDateTime",
          "required": true,
          "label": "Expira em",
          "filterable": true,
          "sortable": true
        },
        {
          "name": "revokedAt",
          "type": "LocalDateTime",
          "label": "Revogado em",
          "filterable": true,
          "sortable": true
        }
      ],
      "relations": [
        {
          "type": "ManyToOne",
          "targetEntity": "Category",
          "fieldName": "owner",
          "joinColumn": "owner_id",
          "required": true,
          "fetch": "LAZY",
          "cascade": "MERGE",
          "displayField": "name",
          "inRequest": true,
          "inResponse": true
        }
      ],
      "crud": {
        "pagination": true,
        "defaultPageSize": 20,
        "maxPageSize": 100,
        "sortable": [
          "id",
          "expiresAt",
          "revokedAt"
        ],
        "filterable": [
          {
            "name": "ipAddress",
            "type": "String",
            "operator": "CONTAINS",
            "targetField": "ipAddress",
            "label": "IP"
          }
        ]
      }
    }
  ]
}